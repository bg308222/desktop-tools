{
  "name": "trade-journal",
  "private": true,
  "version": "0.1.0",
  "description": "交易記錄與復盤工具",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && vite build",
