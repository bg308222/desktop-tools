# 複製成 .env 後修改：設定預設操作的 app，之後可省略 app 參數
# 例如：just dev  ==  just dev trade-journal
APP=trade-journal

# ── docker compose 部署用（docker-compose.yml 會讀）──────────────
# 各 app 要部署的 image tag（= just build 產出的版本號，見各 app package.json）
TRADE_JOURNAL_TAG=0.1.1
# 各 app 對外的主機埠（容器內固定 3000）
TRADE_JOURNAL_PORT=21001
